FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    GOPATH=/go \
    GOBIN=/usr/local/bin \
    PATH=/usr/local/go/bin:/go/bin:/usr/local/bin:/usr/bin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget git unzip jq python3 python3-pip python3-venv \
    openssl openssh-client bind9-dnsutils whois nmap ffuf \
    chromium xvfb xauth && rm -rf /var/lib/apt/lists/*

# Go is pinned to a known release; individual tools use explicit versions below.
ARG GO_VERSION=1.23.6
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz

ARG SUBFINDER=v2.8.0
ARG DNSX=v1.4.2
ARG HTTPX=v1.7.0
ARG NAABU=v2.3.3
ARG KATANA=v1.1.3
ARG NUCLEI=v3.3.10
ARG AMASS=v4.2.0
ARG ASSETFINDER=v0.4.1
ARG GAU=v2.2.4
ARG WAYBACKURLS=v0.3.1
ARG GOWITNESS=v3.0.5

RUN /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/subfinder/v2/cmd/subfinder@${SUBFINDER} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/dnsx/cmd/dnsx@${DNSX} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/httpx/cmd/httpx@${HTTPX} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/naabu/v2/cmd/naabu@${NAABU} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/katana/cmd/katana@${KATANA} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/projectdiscovery/nuclei/v3/cmd/nuclei@${NUCLEI} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/owasp-amass/amass/v4/...@${AMASS} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/tomnomnom/assetfinder@${ASSETFINDER} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/lc/gau/v2/cmd/gau@${GAU} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/tomnomnom/waybackurls@${WAYBACKURLS} \
    && /usr/local/go/bin/go install -ldflags="-s -w" github.com/sensepost/gowitness@${GOWITNESS}

RUN python3 -m venv /opt/dirsearch && /opt/dirsearch/bin/pip install --no-cache-dir dirsearch

COPY tools/tool-registry.json /opt/bountydeck/tool-registry.json
COPY tools/entrypoint-tools.sh /usr/local/bin/bountydeck-tools
RUN chmod 0755 /usr/local/bin/bountydeck-tools

VOLUME ["/opt/bountydeck/tools", "/root/.config", "/root/.cache"]
ENTRYPOINT ["/usr/local/bin/bountydeck-tools"]
