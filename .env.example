# Copy this file to .env and replace every placeholder.
# Generate values with: openssl rand -hex 32
BOUNTYDECK_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
BOUNTYDECK_SECRET_KEY=replace-with-at-least-64-random-hex-characters
# Local only: leave as 0. VPS behind Caddy: set to 1.
BOUNTYDECK_HTTPS=0
# VPS only: set to a DNS name pointing at this server, e.g. bounty.example.com
BOUNTYDECK_DOMAIN=localhost
